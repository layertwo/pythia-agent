# Model provider override (ollama, openai, anthropic, bedrock, litellm)
# PYTHIA_MODEL_PROVIDER=ollama
# PYTHIA_MODEL_ID=llama3.1

# ---- Ollama Cloud ----
# Get a key at https://ollama.com -> Settings -> API keys.
# The ollama python client reads OLLAMA_API_KEY and adds the Bearer header
# automatically, so both the Strands agent model and mem0's LLM authenticate
# without code changes. Embedder stays local (cloud has no embedding models).
# OLLAMA_API_KEY=
# PYTHIA_OLLAMA_HOST=https://ollama.com
# PYTHIA_MEMORY_LLM_OLLAMA_BASE_URL=https://ollama.com
# Pick exact IDs from https://ollama.com/search?c=cloud, e.g. gpt-oss:120b-cloud
# PYTHIA_MODEL_ID=gpt-oss:120b-cloud
# PYTHIA_MEMORY_LLM_MODEL=gpt-oss:120b-cloud

# Local Ollama embedder defaults (override only if needed)
# PYTHIA_MEMORY_EMBEDDER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# PYTHIA_MEMORY_EMBEDDER_MODEL=nomic-embed-text-v2-moe

# OpenAI (when using openai provider)
# OPENAI_API_KEY=sk-...

# Anthropic (when using anthropic provider)
# ANTHROPIC_API_KEY=sk-ant-...

# AWS Bedrock (when using bedrock provider)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
